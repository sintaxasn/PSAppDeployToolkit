{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& { $project = $env:CLAUDE_PROJECT_DIR; if (-not $project) { $project = (Get-Location).Path }; & (Join-Path $project '.claude/hooks/post-tool-format-xaml.ps1') }\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
